{
  "manifest_version": 3,
  "name": "Drive Delivery · 网盘发货助手",
  "version": "0.1.0",
  "description": "Upload files and folders directly to your cloud drives. 独立上传文件和文件夹，支持暂停队列。",
  "minimum_chrome_version": "116",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*",
    "https://*.up.1drv.com/*",
    "https://*.sharepoint.com/*",
    "https://*.onedrive.com/*",
    "https://openapi.baidu.com/*",
    "https://pan.baidu.com/*",
    "https://d.pcs.baidu.com/*"
  ],
  "oauth2": {
    "client_id": "0-configure.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Drive Delivery / 打开网盘发货助手"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "key": ""
}
